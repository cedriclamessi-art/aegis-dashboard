# ── LLM Provider ─────────────────────────────────────────
# ollama = gratuit, local (defaut)
# groq = gratuit, ultra rapide (cle sur console.groq.com)
# openrouter = agregateur (cle sur openrouter.ai)
# gemini = Google free tier (cle sur aistudio.google.com)
# anthropic = payant, meilleure qualite
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Anthropic (si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Composio OAuth (optionnel)
COMPOSIO_API_KEY=

# Meta Ads direct API (optionnel)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_123456789

# App
ALLOWED_ORIGIN=*
PORT=8000
DATABASE_PATH=aegis.db
